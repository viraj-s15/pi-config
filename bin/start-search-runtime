#!/bin/zsh
set -eu

export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

if ! /opt/homebrew/bin/colima status >/dev/null 2>&1; then
  /opt/homebrew/bin/colima start
fi

for attempt in {1..60}; do
  if /opt/homebrew/bin/docker --context colima info >/dev/null 2>&1; then
    /opt/homebrew/bin/docker --context colima start pi-searxng
    exit 0
  fi
  sleep 2
done

print -u2 'Colima started, but Docker did not become ready within 120 seconds.'
exit 1
